---
import "../styles/blog.css";

// 1. IMPORTAMOS LOS COMPONENTES NECESARIOS
import MainLayout from "@/layouts/MainLayout.astro";
import Navbar from "@/components/Navegadores/Navbar.astro";
import PhotoSwipeUI from "@/components/galerias/PhotoSwipeUI.astro";
import { getDb } from "../lib/db";
import { getEditorUser } from "../lib/auriculoterapia-auth";

const visitor = await getEditorUser(Astro.request).catch(() => null);

// 2. DEFINIMOS LOS DATOS ÚNICOS DE ESTA PÁGINA
const pageTitle = "Rodrigo Pizarro - Blog";
const pageDescription = "Sitio personal de Rodrigo Pizarro - Blog sobre temas varios.";

type BlogPost = {
  slug: string;
  icon: string;
  title: string;
  summary: string;
  introTitle: string;
  intro: string;
  sectionTitle: string;
  body: string;
  date?: string;
  categories: string[];
  coverImage?: string;
  images: { src: string; alt: string }[];
  published?: boolean;
  publishedAt?: string | Date;
  bodyHtml?: string;
};

const blogModules = import.meta.glob("../data/blog/*.ts", {
  eager: true,
  import: "default",
});
const staticPosts = Object.values(blogModules) as BlogPost[];
let databasePosts: BlogPost[] = [];
try {
  const records = await (await getDb())
    .collection("blog_posts")
    .find({ published: true })
    .sort({ publishedAt: -1, createdAt: -1 })
    .toArray();
  databasePosts = records.map(
    (record): BlogPost => ({
      slug: String(record.slug || ""),
      icon: String(record.icon || "fa-newspaper"),
      title: String(record.title || ""),
      summary: String(record.summary || ""),
      introTitle: String(record.introTitle || ""),
      intro: String(record.intro || ""),
      sectionTitle: String(record.sectionTitle || ""),
      body: String(record.body || ""),
      date: String(record.date || ""),
      categories: Array.isArray(record.categories) ? record.categories.map(String) : [],
      coverImage: String(record.coverImage || ""),
      images: Array.isArray(record.images)
        ? record.images.map((image: { src?: string; alt?: string }) => ({
            src: String(image.src || ""),
            alt: String(image.alt || ""),
          }))
        : [],
      published: true,
      publishedAt: record.publishedAt,
      bodyHtml: String(record.body || ""),
    }),
  );
} catch (error) {
  console.warn("No se pudieron cargar entradas de blog desde MongoDB.", error);
}
const postsBySlug = new Map(staticPosts.map((post) => [post.slug, post]));
databasePosts.forEach((post) => postsBySlug.set(post.slug, post));
const blogPosts = [...postsBySlug.values()].sort((left, right) => {
  const getTime = (post: BlogPost) => {
    const date = post.publishedAt || post.date;
    const timestamp = date ? new Date(date).getTime() : 0;
    return Number.isFinite(timestamp) ? timestamp : 0;
  };
  return getTime(right) - getTime(left);
});

// Extraer categorías únicas para los botones de filtro
const allCategories = Array.from(new Set(blogPosts.flatMap((post) => post.categories || [])));
---

<MainLayout title={pageTitle} description={pageDescription}>
  <Navbar />

  <main id="main-content" class="px-6 max-w-5xl mx-auto mb-12 mt-12">
    <section id="blog" class="min-h-screen flex flex-col justify-center section-bg-paper">
      <div class="container mx-auto px-6">
        <div class="blog-account-bar">
          {
            visitor ? (
              <>
                <span>Conectado como {visitor.name}</span>
                {visitor.role === "admin" && <a href="/admin/blog">Administrar blog</a>}
                <button type="button" id="blog-signout">Cerrar sesión</button>
              </>
            ) : (
              <button type="button" data-blog-auth-open data-return-to="/blog">
                Ingresar para participar
              </button>
            )
          }
        </div>
        <h2 class="font-title text-3xl md:text-4xl lg:text-5xl text-center mb-6">
          Espacio de reflexión y exploración
        </h2>
        <p class="text-lg text-neutral-600 text-center max-w-3xl mx-auto mb-8">
          En este blog comparto mis pensamientos, experiencias y cosas que me gustan y disgustan.Algunas serán relacionadas con el Neidan, MTC y parecidas; otras del día a dia, series, animaciónes, videos experimentales, filosofía, copypasta, entre otras cosas. Se ordenan en el orden en que salen, pero no precisamente por un orden de temas, así que podes filtrar las categorías abajo. 
        </p>

        <!-- Filtros por Categoría -->
        <div class="mb-10">
          <p class="text-base font-semibold mb-3">Filtrar por categorías:</p>
          <div class="flex flex-wrap gap-2" id="filter-buttons">
            <button
              type="button"
              data-filter="todos"
              class="filter-btn active-filter interest-tag hover cursor-pointer"
            >
              TODOS ({blogPosts.length})
            </button>
            {
              allCategories.map((cat) => {
                const count = blogPosts.filter((p) => p.categories?.includes(cat)).length;
                return (
                  <button
                    type="button"
                    data-filter={cat}
                    class="filter-btn interest-tag cursor-pointer"
                  >
                    {cat.toUpperCase()} ({count})
                  </button>
                );
              })
            }
          </div>
        </div>

        <!-- Grid de Tarjetas -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="blog-grid">
          {
            blogPosts.map((post) => {
              const imgSrc = post.coverImage || (post.images && post.images[0]?.src);
              return (
                <article
                  class="custom-blog-card blog-card"
                  data-blog-post={post.slug}
                  data-categories={JSON.stringify(post.categories || [])}
                  role="button"
                  tabindex="0"
                  aria-haspopup="dialog"
                >
                  <!-- Contenedor Superior: Imagen -->
                  {imgSrc && (
                    <div class="card-image-container">
                      <img
                        src={imgSrc}
                        alt={post.title}
                        class="card-image"
                      />
                    </div>
                  )}

                  <!-- Contenedor Inferior: Contenido -->
                  <div class="card-body">
                    {post.date && (
                      <time class="card-date">{post.date}</time>
                    )}
                    <h3 class="card-title">
                      <i aria-hidden="true" class={`fas ${post.icon || 'fa-newspaper'} text-chinese-seal-red`} />
                      <span>{post.title}</span>
                    </h3>
                    <p class="card-summary">{post.summary}</p>

                    <div class="card-footer">
                      <div class="card-tags">
                        {post.categories?.map((cat) => (
                          <span class="interest-tag hover">
                            {cat}
                          </span>
                        ))}
                      </div>
                      <span class="read-more-link">Leer post &rarr;</span>
                    </div>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>

  <!-- Dialog Modal -->
  <dialog id="blog-post-dialog" class="blog-post-dialog" aria-labelledby="blog-post-title">
    <div class="blog-post-dialog__inner">
      <button
        class="blog-post-dialog__close"
        type="button"
        data-blog-close
        aria-label="Cerrar post"
      >
        <i class="fas fa-times" aria-hidden="true"></i>
      </button>
      <article id="blog-post-content" class="blog-post-content"></article>
      <div class="blog-post-dialog__actions">
        <button class="button-manuscript" type="button" data-blog-share>
          <i class="fas fa-share-alt" aria-hidden="true"></i> Compartir
        </button>
        <a class="button-manuscript" data-blog-whatsapp target="_blank" rel="noopener noreferrer">
          <i class="fab fa-whatsapp" aria-hidden="true"></i> WhatsApp
        </a>
      </div>
    </div>
  </dialog>

  <dialog id="blog-auth-dialog" class="blog-auth-dialog" aria-labelledby="blog-auth-title">
    <form id="blog-auth-form" class="blog-auth-form" novalidate>
      <button
        class="blog-post-dialog__close"
        type="button"
        data-blog-auth-close
        aria-label="Cerrar ingreso"
      >
        <i class="fas fa-times" aria-hidden="true"></i>
      </button>
      <h2 id="blog-auth-title">Ingresar al blog</h2>
      <p id="blog-auth-status" role="status" aria-live="polite"></p>
      <label id="blog-auth-name-field" hidden>
        Nombre
        <input name="name" type="text" autocomplete="given-name" />
      </label>
      <label>
        Correo electrónico
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label>
        Contraseña
        <input name="password" type="password" autocomplete="current-password" required />
      </label>
      <button class="blog-auth-submit" id="blog-auth-submit" type="submit">Ingresar</button>
      <p class="blog-auth-switch">
        <span id="blog-auth-switch-copy">¿No tienes cuenta?</span>
        <button id="blog-auth-toggle" type="button">Crear una cuenta</button>
      </p>
      <div class="blog-auth-divider"><span>O continuar con</span></div>
      <button id="blog-auth-google" type="button" class="blog-auth-google">
        <i class="fab fa-google" aria-hidden="true"></i> Google
      </button>
    </form>
  </dialog>

  {
    blogPosts.map((post) => (
      <template id={`blog-post-${post.slug}`}>
        <h1 id="blog-post-title">{post.title}</h1>
        <h2>{post.introTitle}</h2>
        <p>{post.intro}</p>
        <h3>{post.sectionTitle}</h3>
        {post.bodyHtml ? <div set:html={post.bodyHtml} /> : <p>{post.body}</p>}
        <div class="blog-post-content__images">
          {post.images.map((image) => (
            <img src={image.src} alt={image.alt} />
          ))}
        </div>
      </template>
    ))
  }

  <script>
    import { signIn, signOut } from "auth-astro/client";
    import "../js/blog-modal.js";

    const blogSignIn = signIn as unknown as (
      providerId: string,
      options?: {
        email?: string;
        password?: string;
        redirect?: boolean;
        callbackUrl?: string;
      },
      authorizationParams?: Record<string, string>,
    ) => Promise<void | Response>;
    const blogAuthDialog = document.querySelector<HTMLDialogElement>("#blog-auth-dialog");
    const blogAuthForm = document.querySelector<HTMLFormElement>("#blog-auth-form");
    const blogAuthStatus = document.querySelector<HTMLElement>("#blog-auth-status");
    const blogAuthNameField = document.querySelector<HTMLLabelElement>("#blog-auth-name-field");
    const blogAuthTitle = document.querySelector<HTMLElement>("#blog-auth-title");
    const blogAuthSubmit = document.querySelector<HTMLButtonElement>("#blog-auth-submit");
    let blogAuthRegisterMode = false;

    function blogAuthReturnTo(value: string) {
      try {
        const url = new URL(value, window.location.origin);
        if (url.origin === window.location.origin && url.pathname === "/blog") {
          return `${url.pathname}${url.search}${url.hash}`;
        }
      } catch {
        return "/blog";
      }
      return "/blog";
    }

    function openBlogAuth(returnTo: string) {
      if (!blogAuthDialog) return;
      blogAuthDialog.dataset.returnTo = blogAuthReturnTo(returnTo);
      blogAuthStatus && (blogAuthStatus.textContent = "");
      blogAuthDialog.showModal();
      blogAuthForm?.querySelector<HTMLInputElement>('input[name="email"]')?.focus();
    }

    function updateBlogAuthMode() {
      if (blogAuthTitle) {
        blogAuthTitle.textContent = blogAuthRegisterMode ? "Crear cuenta para el blog" : "Ingresar al blog";
      }
      if (blogAuthSubmit) blogAuthSubmit.textContent = blogAuthRegisterMode ? "Crear cuenta" : "Ingresar";
      if (blogAuthNameField) {
        blogAuthNameField.hidden = !blogAuthRegisterMode;
        const input = blogAuthNameField.querySelector<HTMLInputElement>("input");
        if (input) input.required = blogAuthRegisterMode;
      }
      const switchCopy = document.querySelector<HTMLElement>("#blog-auth-switch-copy");
      const switchButton = document.querySelector<HTMLButtonElement>("#blog-auth-toggle");
      if (switchCopy) switchCopy.textContent = blogAuthRegisterMode ? "¿Ya tienes cuenta?" : "¿No tienes cuenta?";
      if (switchButton) switchButton.textContent = blogAuthRegisterMode ? "Ingresar" : "Crear una cuenta";
      const password = blogAuthForm?.querySelector<HTMLInputElement>('input[name="password"]');
      if (password) password.autocomplete = blogAuthRegisterMode ? "new-password" : "current-password";
    }

    document.querySelectorAll<HTMLButtonElement>("[data-blog-auth-open]").forEach((button) => {
      button.addEventListener("click", () => openBlogAuth(button.dataset.returnTo || "/blog"));
    });
    document.addEventListener("blog-auth:open", (event) => {
      const detail = (event as CustomEvent<{ returnTo?: string }>).detail;
      openBlogAuth(detail?.returnTo || "/blog");
    });
    document.querySelector("[data-blog-auth-close]")?.addEventListener("click", () => {
      blogAuthDialog?.close();
    });
    blogAuthDialog?.addEventListener("click", (event) => {
      if (event.target === blogAuthDialog) blogAuthDialog.close();
    });
    document.querySelector("#blog-auth-toggle")?.addEventListener("click", () => {
      blogAuthRegisterMode = !blogAuthRegisterMode;
      updateBlogAuthMode();
      blogAuthStatus && (blogAuthStatus.textContent = "");
    });
    blogAuthForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!blogAuthForm || !blogAuthStatus) return;
      const formData = new FormData(blogAuthForm);
      const name = String(formData.get("name") || "").trim();
      const email = String(formData.get("email") || "").trim();
      const password = String(formData.get("password") || "");
      if (!email || !password || (blogAuthRegisterMode && !name)) {
        blogAuthStatus.textContent = "Completa los campos requeridos.";
        return;
      }

      if (blogAuthSubmit) blogAuthSubmit.disabled = true;
      blogAuthStatus.textContent = "";
      try {
        if (blogAuthRegisterMode) {
          const response = await fetch("/api/register", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ nombre: name, apellido: "", email, password }),
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.message || "No se pudo crear la cuenta.");
        }

        const result = await blogSignIn("credentials", {
          email,
          password,
          redirect: false,
          callbackUrl: blogAuthDialog?.dataset.returnTo || "/blog",
        });
        if (result instanceof Response) throw new Error("Email o contraseña incorrectos.");
        window.location.assign(blogAuthDialog?.dataset.returnTo || "/blog");
      } catch (error) {
        blogAuthStatus.textContent = error instanceof Error ? error.message : "No se pudo ingresar.";
        if (blogAuthSubmit) blogAuthSubmit.disabled = false;
      }
    });
    document.querySelector("#blog-auth-google")?.addEventListener("click", () => {
      void blogSignIn(
        "google",
        { callbackUrl: blogAuthDialog?.dataset.returnTo || "/blog" },
        { prompt: "select_account" },
      );
    });
    updateBlogAuthMode();

    document.getElementById("blog-signout")?.addEventListener("click", () => {
      void signOut();
    });

    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const blogCards = document.querySelectorAll<HTMLElement>(".blog-card");

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter;

        filterButtons.forEach((b) => {
          b.classList.remove("hover");
        });
        btn.classList.add("hover");

        blogCards.forEach((card) => {
          const categories: string[] = JSON.parse(card.dataset.categories || "[]");
          if (filter === "todos" || categories.includes(filter || "")) {
            card.style.display = "flex";
          } else {
            card.style.display = "none";
          }
        });
      });
    });
  </script>
  <PhotoSwipeUI />
</MainLayout>