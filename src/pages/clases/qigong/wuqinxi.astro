              <td class="py-3 px-4 font-semibold">2.º</td>
              <td class="py-3 px-4">鹿 Ciervo</td>
              <td class="py-3 px-4">水行系统 (Shuǐ xíng xìtǒng)</td>
              <td class="py-3 px-4">肾 Riñón</td>
              <td class="py-3 px-4">Norte</td>
              <td class="py-3 px-4">Invierno</td>
            </tr>
