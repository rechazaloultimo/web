              <th class="py-3 px-4 text-left font-title">Sistema</th>
              <th class="py-3 px-4 text-left font-title">Órgano Yin</th>
              <th class="py-3 px-4 text-left font-title">Órgano Yang</th>
              <th class="py-3 px-4 text-left font-title">Emoción</th>
              <th class="py-3 px-4 text-left font-title">Cualidad</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-300 hover:bg-gray-50">
              <td class="py-3 px-4 font-semibold">虎 Tigre</td>
              <td class="py-3 px-4"><strong>Madera</strong></td>
              <td class="py-3 px-4">Hígado</td>
              <td class="py-3 px-4">Vesícula Biliar</td>
              <td class="py-3 px-4">Ira</td>
              <td class="py-3 px-4">
                Firmeza serena, decisión, coraje, iniciativa, visión estratégica
              </td>
            </tr>
            <tr class="border-b border-gray-300 hover:bg-gray-50">
              <td class="py-3 px-4 font-semibold">鹿 Ciervo</td>
              <td class="py-3 px-4"><strong>Agua</strong></td>
              <td class="py-3 px-4">Riñón</td>
              <td class="py-3 px-4">Vejiga</td>
              <td class="py-3 px-4">Miedo</td>
              <td class="py-3 px-4">
                Serenidad, confianza, flexibilidad, resistencia, sabiduría profunda
              </td>
            </tr>
            <tr class="border-b border-gray-300 hover:bg-gray-50">
              <td class="py-3 px-4 font-semibold">熊 Oso</td>
              <td class="py-3 px-4"><strong>Tierra</strong></td>
              <td class="py-3 px-4">Bazo</td>
              <td class="py-3 px-4">Estómago</td>
              <td class="py-3 px-4">Preocupación</td>
              <td class="py-3 px-4">
                Estabilidad, centrado, solidez, nutrición, confianza en el proceso
              </td>
            </tr>
            <tr class="border-b border-gray-300 hover:bg-gray-50">
              <td class="py-3 px-4 font-semibold">猿 Mono</td>
              <td class="py-3 px-4"><strong>Fuego</strong></td>
              <td class="py-3 px-4">Corazón</td>
              <td class="py-3 px-4">Intestino Delgado</td>
              <td class="py-3 px-4">Alegría</td>
              <td class="py-3 px-4">
                Alegría serena, agilidad mental, presencia, vivacidad, claridad
              </td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="py-3 px-4 font-semibold">鸟 Ave (Grulla)</td>
