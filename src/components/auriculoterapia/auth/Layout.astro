---
interface Props {
  title?: string;
}

const { title = "Auriculoterapia — Acceso y Planes" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="auth-wrapper">
      <div class="auth-card">
        <slot />
      </div>
    </div>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family:
      "Plus Jakarta Sans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
  }

  :root {
    --bg-dark: #080303;
    --card-bg: #120707;
    --card-border: #2e1010;
    --input-bg: #1c0a0a;
    --input-border: #421616;
    --accent-red: #b71414;
    --accent-red-dark: #860d0d;
    --accent-red-bright: #f52c2c;
    --accent-gold: #ffea07;
    --text-white: #f8fafc;
    --text-dim: #a89494;
    --error-red: #ff5f5f;
    --success-green: #2ecc71;
  }

  body {
    background: radial-gradient(circle at 50% 0%, #360808 0%, #080303 75%);
    color: var(--text-white);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  a,
  a:visited {
    color: var(--accent-red-bright);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: #ff6666;
    text-decoration: underline;
  }

  .auth-wrapper {
    width: 100%;
    max-width: 1040px;
  }

  .auth-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 24px;
    display: flex;
    overflow: hidden;
    min-height: 620px;
    box-shadow:
      0 25px 60px -15px rgba(0, 0, 0, 0.85),
      0 0 35px rgba(183, 20, 20, 0.25);
  }

  .left-panel {
    flex: 1.1;
    background: linear-gradient(160deg, #2b0808 0%, #170404 50%, #0a0202 100%);
    position: relative;
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid var(--card-border);
  }

  .top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 10;
  }

  .brand-logo {
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: -0.03em;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .badge-plan {
    background: rgba(245, 44, 44, 0.15);
    border: 1px solid var(--accent-red-bright);
    color: #ff9999;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .badge-plan:hover {
    background: rgba(245, 44, 44, 0.2);
    transform: translateY(-1px);
  }

  .slider-container {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    margin-top: 22px;
    border-radius: 22px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .slide {
    position: absolute;
    inset: 0;
    display: none;
    opacity: 0;
    transform: scale(0.98);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  .slide.active {
    display: block;
    opacity: 1;
    transform: scale(1);
  }

  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.1) contrast(1.05);
  }

  .slide-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(10, 3, 3, 0.9) 35%,
      rgba(10, 3, 3, 1) 100%
    );
    padding: 1.5rem 1.2rem 1.2rem;
  }

  .slide-overlay h3 {
    font-size: clamp(1.5rem, 2.4vw, 2.3rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
    letter-spacing: -0.05em;
  }

  .slide-overlay p {
    color: rgba(248, 250, 252, 0.8);
    max-width: 32rem;
    line-height: 1.6;
  }

  .plans-slide-content {
    height: 100%;
    padding: 1.5rem 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
  }

  .slide-tag {
    align-self: flex-start;
    border: 1px solid rgba(255, 234, 7, 0.5);
    background: rgba(255, 234, 7, 0.11);
    color: var(--accent-gold);
    border-radius: 999px;
    padding: 0.42rem 0.7rem;
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .plans-mini-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 0.5rem;
  }

  .plan-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    background: rgba(20, 7, 7, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 1rem 0.9rem;
    min-height: 180px;
  }

  .plan-card.featured {
    border-color: rgba(245, 44, 44, 0.5);
    box-shadow: inset 0 0 0 1px rgba(245, 44, 44, 0.2);
  }

  .plan-card-premium {
    border-color: rgba(255, 234, 7, 0.45);
  }

  .plan-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .title-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .plan-card h4 {
    font-size: 1.02rem;
    font-weight: 800;
  }

  .plan-price {
    color: var(--accent-gold);
    font-weight: 800;
    font-size: 0.9rem;
  }

  .plan-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    color: #f1d9d9;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .plan-card li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .pop-tag {
    border-radius: 999px;
    background: rgba(245, 44, 44, 0.18);
    color: #ffb2b2;
    padding: 0.25rem 0.5rem;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .slider-dots {
    display: flex;
    justify-content: center;
    gap: 0.55rem;
    margin-top: 14px;
  }

  .slider-dots .dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    border: none;
    background: rgba(255, 255, 255, 0.2);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .slider-dots .dot.active {
    width: 26px;
    background: linear-gradient(90deg, var(--accent-red-bright), #ff7a7a);
  }

  .right-panel {
    flex: 0.9;
    padding: 36px 30px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: rgba(10, 2, 2, 0.7);
  }

  .auth-header {
    margin-bottom: 1.5rem;
  }

  .auth-header h2 {
    font-size: clamp(1.8rem, 2.6vw, 2.5rem);
    letter-spacing: -0.06em;
    margin-bottom: 0.55rem;
  }

  .auth-header p {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .input-row {
    display: flex;
    gap: 0.8rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .auth-form input {
    width: 100%;
    border: 1px solid var(--input-border);
    background: var(--input-bg);
    color: var(--text-white);
    border-radius: 14px;
    padding: 0.9rem 1rem;
    font-size: 0.98rem;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .auth-form input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .auth-form input:focus {
    outline: none;
    border-color: rgba(245, 44, 44, 0.7);
    box-shadow: 0 0 0 3px rgba(245, 44, 44, 0.12);
  }

  .password-group {
    position: relative;
  }

  .toggle-password {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    font-size: 1rem;
  }

  .checkbox-group {
    margin-top: 0.2rem;
  }

  .custom-checkbox {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  .custom-checkbox input {
    width: 16px;
    height: 16px;
    accent-color: var(--accent-red-bright);
  }

  .btn-submit,
  .btn-social {
    border: none;
    border-radius: 14px;
    cursor: pointer;
    font-weight: 700;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .btn-submit {
    background: linear-gradient(135deg, var(--accent-red-bright), var(--accent-red));
    color: var(--text-white);
    padding: 1rem 1.1rem;
    font-size: 1rem;
    margin-top: 0.2rem;
  }

  .btn-submit:hover,
  .btn-social:hover {
    transform: translateY(-1px);
    opacity: 0.98;
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0.25rem 0;
    color: var(--text-dim);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .divider::before,
  .divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
  }

  .social-buttons {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.2rem;
  }

  .btn-social {
    flex: 1;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-white);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.9rem 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
  }

  .status-message {
    min-height: 1.4rem;
    font-size: 0.88rem;
    color: var(--error-red);
  }

  .status-message.success {
    color: var(--success-green);
  }

  @media (max-width: 820px) {
    .auth-card {
      flex-direction: column;
    }

    .left-panel {
      min-height: 390px;
      border-right: none;
      border-bottom: 1px solid var(--card-border);
    }

    .plans-mini-grid {
      grid-template-columns: 1fr;
    }

    .input-row {
      flex-direction: column;
    }
  }
</style>
