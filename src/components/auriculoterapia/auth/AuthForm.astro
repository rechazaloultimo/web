---

---

<div class="right-panel">
  <div class="auth-header">
    <h2 id="formTitle">Crear una cuenta</h2>
    <p id="formToggleSubtext">
      ¿Ya tienes una cuenta? <a href="#" id="toggleAuthMode">Iniciar sesión</a>
    </p>
  </div>

  <form id="authForm" class="auth-form" method="post" novalidate>
    <div class="input-row" id="nameFields">
      <div class="input-group">
        <input type="text" id="nombre" name="nombre" placeholder="Nombre" required />
      </div>
      <div class="input-group">
        <input type="text" id="apellido" name="apellido" placeholder="Apellido" />
      </div>
    </div>

    <div class="input-group">
      <input type="email" id="email" name="email" placeholder="Correo electrónico" required />
    </div>

    <div class="input-group password-group">
      <input type="password" id="password" name="password" placeholder="Contraseña" required />
      <button
        type="button"
        class="toggle-password"
        id="btnTogglePass"
        aria-label="Mostrar contraseña">👁</button
      >
    </div>

    <div class="checkbox-group" id="termsGroup">
      <label class="custom-checkbox">
        <input type="checkbox" id="terms" required />
        <span class="checkmark"></span>
        Acepto los <a href="#">Términos & Condiciones</a>
      </label>
    </div>

    <button type="submit" class="btn-submit" id="btnSubmit">Crear cuenta</button>
    <div id="formStatus" class="status-message" aria-live="polite"></div>

    <div class="divider">
      <span>O continuar con</span>
    </div>

    <div class="social-buttons">
      <button type="button" class="btn-social" id="btnGoogleLogin">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="#4285F4"
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
          ></path>
          <path
            fill="#34A853"
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
          ></path>
          <path
            fill="#FBBC05"
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
          ></path>
          <path
            fill="#EA4335"
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
          ></path>
        </svg>
        Google
      </button>
    </div>
  </form>
</div>

<script>
  import { signIn, signOut } from "auth-astro/client";

  const authSignIn = signIn as unknown as (
    providerId: string,
    options?: {
      email?: string;
      password?: string;
      redirect?: boolean;
      callbackUrl?: string;
    },
    authorizationParams?: Record<string, string>,
  ) => Promise<void | Response>;
  const authSignOut = signOut as unknown as (options?: { callbackUrl?: string }) => Promise<void>;

  let isRegisterMode = true;

  const formTitle = document.getElementById("formTitle");
  const formToggleSubtext = document.getElementById("formToggleSubtext");
  const nameFields = document.getElementById("nameFields");
  const termsGroup = document.getElementById("termsGroup");
  const btnSubmit = document.getElementById("btnSubmit");
  const authForm = document.getElementById("authForm") as HTMLFormElement | null;
  const btnGoogleLogin = document.getElementById("btnGoogleLogin");
  const btnTogglePass = document.getElementById("btnTogglePass");
  const passInput = document.getElementById("password") as HTMLInputElement | null;
  const formStatus = document.getElementById("formStatus");
  const defaultCallbackUrl = "/servicios/auriculoterapia/editor";
  const requestedCallbackUrl = new URLSearchParams(window.location.search).get("callbackUrl");
  let authCallbackUrl = defaultCallbackUrl;
  if (requestedCallbackUrl) {
    try {
      const candidate = new URL(requestedCallbackUrl, window.location.origin);
      if (candidate.origin === window.location.origin) {
        authCallbackUrl = `${candidate.pathname}${candidate.search}${candidate.hash}`;
      }
    } catch {
      authCallbackUrl = defaultCallbackUrl;
    }
  }

  const setStatus = (message: string, type: "error" | "success" = "error") => {
    if (!formStatus) return;
    formStatus.textContent = message;
    formStatus.classList.toggle("success", type === "success");
  };

  if (new URLSearchParams(window.location.search).has("google-account-switch")) {
    setStatus("Sesión cerrada. Presiona Google otra vez para elegir otra cuenta.", "success");
  }

  const updateAuthUI = () => {
    if (formTitle) formTitle.textContent = isRegisterMode ? "Crear una cuenta" : "Iniciar sesión";

    if (formToggleSubtext) {
      formToggleSubtext.innerHTML = isRegisterMode
        ? '¿Ya tienes una cuenta? <a href="#" id="toggleAuthMode">Iniciar sesión</a>'
        : '¿No tienes cuenta? <a href="#" id="toggleAuthMode">Crear una cuenta</a>';
    }

    if (nameFields) nameFields.style.display = isRegisterMode ? "flex" : "none";
    if (termsGroup) termsGroup.style.display = isRegisterMode ? "block" : "none";
    if (btnSubmit) btnSubmit.textContent = isRegisterMode ? "Crear cuenta" : "Ingresar";
  };

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;

    if (target.id === "toggleAuthMode") {
      event.preventDefault();
      isRegisterMode = !isRegisterMode;
      updateAuthUI();
    }
  });

  btnTogglePass?.addEventListener("click", () => {
    if (!passInput) return;
    passInput.type = passInput.type === "password" ? "text" : "password";
  });

  authForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    setStatus("");

    const formData = new FormData(authForm);
    const nombre = String(formData.get("nombre") ?? "").trim();
    const apellido = String(formData.get("apellido") ?? "").trim();
    const email = String(formData.get("email") ?? "").trim();
    const password = String(formData.get("password") ?? "");

    if (!email || !password || (isRegisterMode && !nombre)) {
      setStatus("Completa todos los campos requeridos.");
      return;
    }

    if (isRegisterMode) {
      const response = await fetch("/api/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ nombre, apellido, email, password }),
      });

      const payload = await response.json();

      if (!response.ok) {
        setStatus(payload.message || "No se pudo crear la cuenta.");
        return;
      }

      const result = await authSignIn("credentials", {
        email,
        password,
        redirect: false,
        callbackUrl: authCallbackUrl,
      });

      if (result instanceof Response) {
        setStatus("La cuenta fue creada, pero ocurrió un error al iniciar sesión.");
        return;
      }

      window.location.href = authCallbackUrl;
      return;
    }

    const result = await authSignIn("credentials", {
      email,
      password,
      redirect: false,
      callbackUrl: authCallbackUrl,
    });

    if (result instanceof Response) {
      setStatus("Email o contraseña incorrectos.");
      return;
    }

    window.location.href = authCallbackUrl;
  });

  btnGoogleLogin?.addEventListener("click", async () => {
    const response = await fetch("/api/auth/session", { cache: "no-store" });
    const session = await response.json().catch(() => null);
    if (session?.user?.email) {
      const switchUrl = new URL("/servicios/auriculoterapia", window.location.origin);
      switchUrl.searchParams.set("google-account-switch", "1");
      switchUrl.searchParams.set("callbackUrl", authCallbackUrl);
      await authSignOut({ callbackUrl: switchUrl.toString() });
      return;
    }
    await authSignIn("google", { callbackUrl: authCallbackUrl }, { prompt: "select_account" });
  });

  updateAuthUI();
</script>
